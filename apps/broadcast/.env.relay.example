# Copy to relay/.env.relay and fill in real values. Never commit relay/.env.relay
# (it holds a YouTube stream key). Values below are fictional placeholders.

# Same pesistulokset.fi match ID the main app watches.
RELAY_MATCH_ID=123456

# Public watch URL of the ORIGINAL livestream (the phone's own YouTube broadcast).
# This broadcast is never touched — the relay only reads it.
RELAY_YOUTUBE_URL=https://www.youtube.com/watch?v=xxxxxxxxxxx

# RTMP ingest for the SECOND ("commentated") broadcast. Create this broadcast
# manually in YouTube Studio first and copy its ingest URL + stream key here.
RELAY_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
RELAY_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# ElevenLabs TTS: when the key is set, ElevenLabs is the primary narration
# engine and Piper only the automatic fallback. See README "ElevenLabs voice".
# ELEVENLABS_API_KEY=
# RELAY_ELEVENLABS_VOICE=onwK4e9ZLuTAKqWW03F9   (Daniel)
# RELAY_ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional overrides (defaults shown):
# RELAY_URL_REFRESH_MS=900000  (proactive source-URL refresh; each refresh is a
#   visible few-second break in the stream — source URLs stay valid ~6 h, so
#   e.g. 14400000 = 4 h is a good value for a normal match)
# RELAY_VOICE=harri-medium
# RELAY_PIPER_BIN=piper
# RELAY_POLL_INTERVAL=6000
# RELAY_NARRATION_GAIN=1.3
# RELAY_DRY_RUN=false
# Announce batter/lineup changes ("Vuorossa X"). Set to false to skip them and
# rely on palot + the periodic situation summary instead. Can also be flipped
# live mid-match via relay/run/.control-<matchId>.json — see README.
# RELAY_ANNOUNCE_BATTER_CHANGES=true
# No-signal slate ("EI SIGNAALIA", issue #104): when the source is gone, keep
# pushing a still picture with the narration on top instead of pausing the RTMP
# push. DEFAULT OFF — this is a new ffmpeg path that runs exactly when the
# broadcast is already in trouble and it has not been tried live yet, so the
# first attempt must be a deliberate choice. See README "No-signal slate".
# RELAY_NO_SIGNAL_SLATE=false
# How long the source must be missing before the slate engages; a one-second
# respawn blip must not flash it. Floored at 2000.
# RELAY_NO_SIGNAL_SLATE_AFTER_MS=8000
# Slate resolution. SET THIS TO THE SOURCE'S RESOLUTION (a handheld phone
# stream is often 1280x720): the slate pushes to the same RTMP key, and a
# mismatch restarts YouTube's transcoder both on the way in and on the way
# back — two extra viewer-side blips per outage.
# RELAY_NO_SIGNAL_SLATE_SIZE=1920x1080
# PESISTULOKSET_API_KEY=
# PESISTULOKSET_API_BASE=
