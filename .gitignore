node_modules/
dist/
.env
.state-*.json
.pronunciations.json
debug.log
# .claude/ on muuten paikallinen, mutta skillit versioidaan.
# Huom: emohakemisto pitää ignorata muodossa .claude/* (ei .claude/),
# muuten git ei laskeudu hakemistoon eikä !-poikkeus toimi.
.claude/*
!.claude/skills/
.claude-remote-control.log
.claude-remote-control.pid
# Ajonaikainen roska ja esikatselut MISSÄ TAHANSA run/-hakemistossa. Aiemmin
# tässä oli vain apps/*/run/, ja repojuuren run/ jäi kattamatta — sinne
# generoidut katvekuvan esikatselut päätyivät versionhallintaan vahingossa.
run/
apps/broadcast/run/
apps/broadcast/.env.relay
apps/broadcast/voices/

# TTS API keys must never enter the public repo
*.key
.elevenlabs*

# Ohjaussovelluksen operaattorimedia ja ajonaikainen tila (ei gitiin:
# brändikuvat ovat käyttäjän omaa aineistoa ja repo on julkinen)
apps/control/assets/*
!apps/control/assets/pesaysit-bg-raw-001.png
apps/control/run/
.incoming/
pesis-ai-youtube-pack-*.zip

# Playwright UI -testien artefaktit (kuvakaappaukset, raportit)
apps/control/test-results/
apps/control/playwright-report/
apps/control/.playwright-tmp/

# Sessiokohtaiset muistiinpanot (handoff, aamuraportit). Nämä ovat voimassa
# rajallisen ajan, joten ne eivät kuulu versionhallintaan: mikä niistä on
# pysyvästi arvokasta, kuuluu README/DESIGN/CLAUDE.md:hen tai issueksi.
HANDOFF*.md
AAMU*.md
